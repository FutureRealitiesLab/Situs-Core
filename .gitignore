# Godot – generierte Dateien (nicht committen)
.godot/
*.uid

# Android – Build-Artefakte (Gradle-Output und generierte Dateien)
android/build/
android/.gradle/
# Ausnahmen: manuell gepflegte Dateien im Build-Template
!android/build/src/main/AndroidManifest.xml
# Daemon + Cache deaktiviert – verhindert Einbetten veralteter PCK (grauer Viewport auf Focus 3)
!android/build/gradle.properties

# Export-Artefakte
_apks/
_build/
*.apk
*.apk.idsig
*.aab

# Export-Presets (enthalten lokale Pfade + Keystore-Daten)
export_presets.cfg

# Claude Code (lokale IDE-Einstellungen)
.claude/

# Betriebssystem
.DS_Store
Thumbs.db
desktop.ini

# Editor-Backups
*.tmp
*.bak
*~
